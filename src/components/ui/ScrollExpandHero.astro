---
/* Le rendu tient dans une variable CSS --p (voir .xh dans global.css).
 * theme.js pose html.scrub avant le premier pixel ; hero.js fait varier --p.
 * Sans JavaScript, la page reste lisible et défile normalement. */
interface Props {
  mediaSrc: string;
  mediaWidth: number;
  mediaHeight: number;
  bgSrc: string;
  /** Première moitié du titre, part vers la gauche. */
  titleLeft: string;
  /** Seconde moitié, part vers la droite (accent, italique). */
  titleRight: string;
  /** Vrai bouton posé sur la maquette, à l'emplacement prévu dans l'image. */
  ctaHref?: string;
  ctaLabel?: string;
  /** Texte de vente sur la plaque, visible seulement une fois ouverte. */
  pitchKicker?: string;
  pitchTitle?: string;
  pitchPrice?: string;
  pitchNote?: string;
}
const { mediaSrc, mediaWidth, mediaHeight, bgSrc, titleLeft, titleRight, ctaHref, ctaLabel, pitchKicker, pitchTitle, pitchPrice, pitchNote } = Astro.props;
---
<section class="xh" data-expand-hero aria-labelledby="xh-title">
  <div class="xh-bg" aria-hidden="true">
    <img src={bgSrc} alt="" width="1920" height="1080" fetchpriority="low" decoding="async" />
  </div>
  <slot name="top" />
  <div class="xh-stage">
    <div class="xh-media">
      <img src={mediaSrc} alt="" width={mediaWidth} height={mediaHeight} fetchpriority="high" decoding="async" />
      {pitchTitle && (
        <div class="xh-pitch" aria-hidden="true">
          {pitchKicker && <p class="k">{pitchKicker}</p>}
          <p class="t">{pitchTitle}</p>
          {pitchPrice && <p class="p">{pitchPrice}</p>}
          {pitchNote && <p class="n">{pitchNote}</p>}
        </div>
      )}
      {ctaHref && ctaLabel && <a class="xh-cta" href={ctaHref}>{ctaLabel}</a>}
    </div>
    <h1 class="xh-title" id="xh-title">
      <span class="l">{titleLeft}</span>
      <span class="r">{titleRight}</span>
    </h1>
  </div>
  <slot name="bottom" />
</section>
<script is:inline defer src="/scripts/hero.js"></script>
