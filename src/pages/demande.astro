---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { offers, payment, guarantee, formatChf } from '../config/offre';
import { breadcrumb } from '../lib/schema';

const title = 'Demander un site internet à prix fixe, sans engagement';
const description = `Une minute pour indiquer votre activité et l’offre choisie. Réponse sous ${site.responseTime}. Rien n’est dû avant votre accord écrit sur le prix affiché.`;
---
<Base title={title} description={description} headerCta={false}
  schemas={[breadcrumb([{ name: 'Accueil', path: '/' }, { name: 'Demande', path: '/demande/' }])]}>
  <section class="page">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a> › Demande</nav>
      <div class="section-head">
        <h1>Votre activité, et l’offre.</h1>
        <p class="lede">Une minute. On vous répond sous {site.responseTime} avec un formulaire de projet de 10 minutes, sans rendez-vous téléphonique. Rien n’est dû avant que vous ayez validé l’offre par écrit.</p>
        <p class="aside-note">{guarantee.short}</p>
      </div>

      <form class="form" name="demande" method="POST" action="/merci/" data-netlify="true" netlify-honeypot="societe_web">
        <input type="hidden" name="form-name" value="demande" />
        <p class="hp" aria-hidden="true"><label>Ne pas remplir <input name="societe_web" tabindex="-1" autocomplete="off" /></label></p>

        <fieldset class="field">
          <legend>Quelle offre vous intéresse ?</legend>
          <div class="choices">
            {offers.map((o) => (
              <div class="choice">
                <input type="radio" name="offre" id={`offre-${o.id}`} value={o.id} />
                <label for={`offre-${o.id}`}>{o.name}<small class="num">{formatChf(o.price)} CHF, {o.delayDays} jours ouvrés</small></label>
              </div>
            ))}
            <div class="choice">
              <input type="radio" name="offre" id="offre-hesite" value="hesite" checked />
              <label for="offre-hesite">Je ne sais pas encore<small>On vous conseille par e-mail</small></label>
            </div>
          </div>
        </fieldset>

        <div class="two">
          <div class="field">
            <label for="nom">Prénom et nom</label>
            <input id="nom" name="nom" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="email">E-mail</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>

        <div class="field">
          <label for="tel">Téléphone <span class="hint">(facultatif, si vous préférez un appel ou WhatsApp)</span></label>
          <input id="tel" name="telephone" type="tel" autocomplete="tel" inputmode="tel" />
        </div>

        <div class="field">
          <label for="message">Votre activité et ce que vous attendez du site <span class="hint">(facultatif)</span></label>
          <textarea id="message" name="message" placeholder="ex. Menuiserie à Morges, je veux être trouvé sur Google et recevoir des demandes de devis"></textarea>
        </div>

        <div class="consent">
          <input type="checkbox" id="consentement" name="consentement" value="oui" required />
          <label for="consentement">J’accepte que mes données servent uniquement à répondre à cette demande. Elles ne sont ni vendues ni transmises. <a href="/confidentialite/">Confidentialité</a></label>
        </div>

        <div>
          <button class="btn btn-primary" type="submit">Envoyer</button>
        </div>
        <p class="aside-note">Pour rappel : {payment.deposit} % {payment.depositWhen}, {100 - payment.deposit} % {payment.balanceWhen}. Aucun paiement n’est demandé à cette étape.</p>
      </form>
    </div>
  </section>
  <script is:inline defer src="/scripts/demande.js"></script>
</Base>
