---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { compare, offers, formatChf } from '../config/offre';
import { breadcrumb } from '../lib/schema';

const title = 'Qui réalise votre site internet, SBA system à Morges';
const description = 'SBA System Sàrl, à Morges, conçoit chaque site elle-même. Deux offres à prix fixe, ce qui est compris, ce qui ne l’est pas, et comment nous joindre.';
const refused = compare.filter((row) => row.essentiel === false && row.complet === false);
---
<Base title={title} description={description}
  schemas={[breadcrumb([{ name: 'Accueil', path: '/' }, { name: 'À propos', path: '/a-propos/' }])]}>
  <section class="page">
    <div class="wrap prose">
      <nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a> › À propos</nav>
      <h1>Une personne, à Morges, fait le site.</h1>
      <p class="lede" style="margin-top:1.25rem">La demande arrive chez {site.legalName}. La personne qui répond conçoit le site et le met en ligne. Pas d’équipe à qui passer le dossier.</p>
      <h2>Où écrire</h2>
      <p>
        {site.legalName}<br />
        {site.address.street}<br />
        {site.address.postalCode} {site.address.city}, Suisse<br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      {site.ide && <p>IDE : {site.ide}</p>}
      <h2>Ce qu’on fait</h2>
      <p>Deux offres, {offers.map((o) => `${o.name} ${formatChf(o.price)} CHF`).join(' et ')}. Le tableau de l’accueil dit, ligne par ligne, ce qui est compris. Le prix écrit est le prix facturé.</p>
      <h2>Ce qu’on ne fait pas</h2>
      <ul>
        {refused.map((row) => <li>{row.label}</li>)}
      </ul>
      <p>Les échanges se font en français, par e-mail, depuis la Suisse romande.</p>
      <p><a href="/conditions-generales/">Conditions générales</a> · <a href="/mentions-legales/">Mentions légales</a></p>
    </div>
  </section>
</Base>
