---
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable" description="Cette page n’existe pas." noindex>
  <section class="page">
    <div class="wrap prose">
      <p class="kicker">Erreur 404</p>
      <h1>Cette page n’existe pas.</h1>
      <p class="lede" style="margin-top:1.25rem">Les offres, les prix et le formulaire sont sur la page d’accueil.</p>
      <p><a class="btn btn-primary" href="/">Voir les offres</a></p>
    </div>
  </section>
</Base>
