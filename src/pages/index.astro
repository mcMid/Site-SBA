---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Price from '../components/Price.astro';
import ScrollExpandHero from '../components/ui/ScrollExpandHero.astro';
import Founder from '../components/Founder.astro';
import Realisations from '../components/Realisations.astro';
import { site, reviews } from '../config/site';
import { offers, compare, payment, care, guarantee, steps, faq, formatChf, minPrice } from '../config/offre';
import { organization, website, service, faqPage } from '../lib/schema';

const [essentiel, complet] = offers;
const title = `Site internet à prix fixe dès ${formatChf(minPrice)} CHF, Suisse romande`;
const description = `Votre site web, sur mesure. Essentiel ${formatChf(essentiel.price)} CHF, Complet ${formatChf(complet.price)} CHF. 50 % à la commande, 50 % à la mise en ligne.`;
---
<Base title={title} description={description} preloadImage="/hero/site.webp?v=ecran" schemas={[organization(), website(), service(), faqPage()]}>

  <!-- Hero : une maquette de site s'ouvre au défilement jusqu'à remplir
       l'écran. -->
  <ScrollExpandHero
    mediaSrc="/hero/site.webp?v=ecran" mediaWidth={1600} mediaHeight={1000}
    bgSrc="/hero/bg.webp?v=photo"
    titleLeft="Votre site web," titleRight="sur mesure."
    pitchTitle="Essentiel ou Complet"
    pitchDelay={`${formatChf(essentiel.price)} CHF`}
    pitchPrice={`${formatChf(complet.price)} CHF`}
    ctaHref="#offres" ctaLabel="Voir les offres"
  >
    <p slot="top" class="kicker xh-kicker">Un site professionnel, en Suisse romande</p>
    <div slot="bottom" class="xh-offers">
      {offers.map((o) => (
        <a href={`/demande-de-site-web/?offre=${o.id}`}>{o.name} <strong class="num">{formatChf(o.price)} CHF</strong></a>
      ))}
    </div>
  </ScrollExpandHero>

  <section class="intro" aria-label="En bref">
    <div class="wrap">
      <p class="hero-lede">
        Votre activité mérite un site qui inspire confiance. Le prix est connu dès le départ.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#offres">Voir les offres</a>
        <a class="text-link" href="/demande-de-site-web/">Parler de mon projet</a>
      </div>
      {reviews.count > 0 && (
        <a class="rating" href={reviews.url} rel="noopener" target="_blank">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <strong>{reviews.rating.toFixed(1).replace('.', ',')}/5</strong> sur Google, {reviews.count} avis
        </a>
      )}
      <ul class="proofs">
        <li>Un bon site dit ce que vous faites, pour qui, et comment vous joindre. C’est ce que nous construisons.</li>
        <li>Prix fixe. {payment.deposit} % à la commande, {100 - payment.deposit} % à la mise en ligne. Hébergement offert 1 an. Votre site vous appartient.</li>
        <li>{guarantee.short}</li>
      </ul>
    </div>
  </section>

  <!-- Offres -->
  <section class="section" id="offres" aria-labelledby="offres-titre">
    <div class="wrap">
      <div class="section-head">
        <h2 id="offres-titre">Deux offres. Deux prix. Rien à deviner.</h2>
      </div>
      <div class="offers">
        {offers.map((o, i) => (
          <article class:list={['offer', { 'is-featured': i === 1 }]} id={`offre-${o.id}`} aria-labelledby={`t-${o.id}`}>
            <div class="offer-top">
              <h3 class="offer-name" id={`t-${o.id}`}>{o.name}</h3>
            </div>
            <Price value={o.price} />
            <p class="for">{o.forWho}</p>
            <p style="margin:0">{o.pitch}</p>
            <ul>
              {o.highlights.map((h) => <li><Icon name="check" /><span>{h}</span></li>)}
            </ul>
            <dl class="offer-facts">
              <dt>Délai</dt><dd>{o.delayDays} jours ouvrés</dd>
              <dt>Corrections</dt><dd>{o.revisionRounds} {o.revisionRounds > 1 ? 'tours' : 'tour'} + garantie</dd>
              <dt>À la commande</dt><dd class="num">{formatChf(o.price * payment.deposit / 100)} CHF</dd>
              <dt>À la mise en ligne</dt><dd class="num">{formatChf(o.price * (100 - payment.deposit) / 100)} CHF</dd>
            </dl>
            <a class:list={['btn', i === 1 ? 'btn-primary' : 'btn-ghost']} href={`/demande-de-site-web/?offre=${o.id}`}>
              Choisir {o.id === 'essentiel' ? 'l’Essentiel' : 'le Complet'}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Tableau oui / non -->
  <section class="section" id="inclus" aria-labelledby="inclus-titre">
    <div class="wrap">
      <div class="section-head">
        <h2 id="inclus-titre">Vous n’avez pas besoin d’un devis pour connaître le prix.</h2>
        <p class="lede">Le prix correspond à un périmètre défini : pages, rédaction, corrections, délai et livrables sont écrits noir sur blanc. Une page ou un texte en plus n’apparaît pas sur la facture sans un prix annoncé avant. Pas d’abonnement obligatoire pour garder le site. Pour situer ces montants : <a href="/prix-site-internet-suisse/">prix d’un site internet en Suisse</a>.</p>
      </div>
      <div class="compare-wrap">
        <table class="compare">
          <caption>Le délai, en jours ouvrés, démarre le jour où vos contenus sont complets.</caption>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Prestation</span></th>
              {offers.map((o) => <th scope="col">{o.name}<span class="p num">{formatChf(o.price)} CHF</span></th>)}
            </tr>
          </thead>
          <tbody>
            {compare.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {[row.essentiel, row.complet].map((c) =>
                  <td>
                    {c === true && <span class="yes"><Icon name="check" />Oui</span>}
                    {c === false && <span class="no"><Icon name="minus" />Non</span>}
                    {typeof c === 'string' && <span class="txt">{c}</span>}
                  </td>
                )}
              </tr>
            ))}
            <tr>
              <th scope="row">Délai de mise en ligne</th>
              {offers.map((o) => <td><span class="txt">{o.delayDays} jours</span></td>)}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Paiement et abonnement -->
  <section class="section" id="paiement" aria-labelledby="paiement-titre">
    <div class="wrap">
      <div class="section-head">
        <h2 id="paiement-titre">Vous payez la moitié maintenant. Le reste quand le site est en ligne.</h2>
      </div>
      <div class="split">
        <div class="panel">
          <h3>Le solde, seulement une fois le site en ligne</h3>
          <div class="bar" aria-label={`${payment.deposit} % ${payment.depositWhen}, ${100 - payment.deposit} % ${payment.balanceWhen}`}>
            <div><strong>{payment.deposit} %</strong><span>{payment.depositWhen}</span></div>
            <div><strong>{100 - payment.deposit} %</strong><span>{payment.balanceWhen}</span></div>
          </div>
          <p>Le solde n’est demandé qu’une fois le site terminé, corrigé et mis en ligne sur votre nom de domaine. Pas de paiement intégral avant de voir le résultat.</p>
          <p class="guarantee"><Icon name="check" /><span><strong>Et si le site ne vous plaît pas ?</strong> {guarantee.long}</span></p>
          <p class="muted" style="margin:0">Paiement par {site.paymentMethods.join(', ').replace(/, ([^,]*)$/, ' ou $1')}.</p>
        </div>
        <div class="panel">
          <h3>Vous préférez ne plus vous en occuper ?</h3>
          <p>À partir de la deuxième année, nous pouvons gérer l’hébergement, les mises à jour, les sauvegardes et la surveillance pour {care.price} CHF par mois. La première année, l’hébergement est offert. {care.cancel}</p>
          <div class="care-price">
            <Price value={care.price} suffix=" / mois" />
            <span class="optional">Facultatif</span>
          </div>
          <ul>{care.includes.map((i) => <li>{i}</li>)}</ul>
          <p class="muted" style="margin:0">{care.without}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Étapes -->
  <section class="section" id="etapes" aria-labelledby="etapes-titre">
    <div class="wrap">
      <div class="section-head">
        <h2 id="etapes-titre">Cinq étapes. Vous savez toujours où vous en êtes.</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step">
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <div>
              <h3><span class="sr-only">Étape {i + 1} : </span>{s.title}</h3>
              <p>{s.text}</p>
              <div class="step-meta">
                <span class="chip">{s.who === 'vous' ? 'De votre côté' : 'De notre côté'}</span>
                {s.money && <span class="chip money">{s.money}</span>}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Realisations />
  <Founder />

  <!-- Corrections -->
  <section class="section" id="corrections" aria-labelledby="corrections-titre">
    <div class="wrap">
      <div class="rule-box">
        <span class="big" aria-hidden="true">3</span>
        <div>
          <h2 id="corrections-titre">Les corrections sont prévues. Le projet ne s’étire pas.</h2>
          <p class="lede" style="margin-top:1rem">Un tour sur l’Essentiel, trois sur le Complet. Vous regroupez vos remarques, nous les appliquons en une fois. Si la maquette ne vous convient toujours pas, nous arrêtons et l’acompte vous est rendu.</p>
          <div class="rule-lists">
            <div>
              <h3>Compris</h3>
              <ul>
                <li>Réécrire ou remplacer un texte</li>
                <li>Changer les photos</li>
                <li>Ajuster les couleurs et l’ordre des sections</li>
              </ul>
            </div>
            <div>
              <h3>Pas compris</h3>
              <ul>
                <li>Repartir sur un autre design</li>
                <li>Ajouter des pages hors offre</li>
                <li>Un tour en plus, sauf accord sur le prix avant</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="questions" aria-labelledby="faq-titre">
    <div class="wrap">
      <div class="section-head">
        <h2 id="faq-titre">Les questions à poser avant de décider</h2>
      </div>
      <div class="faq">
        {faq.map(({ q, a }) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Appel final -->
  <section class="section final" aria-labelledby="final-titre">
    <div class="wrap">
      <h2 class="final-head" id="final-titre">
        <span class="final-l1">Mieux qu’un site bricolé </span>
        <span class="final-l2">entre deux rendez-vous.</span>
        <span class="final-k">Réponse sous </span>
        <span class="final-n">{site.responseTime}</span>
      </h2>
      <div class="final-bar">
        <div class="final-terms">
          <p>Expliquez-nous simplement ce que vous faites. Nous répondons sous {site.responseTime}, avec la formule adaptée à votre projet.</p>
          <p>Une minute pour faire la demande. Aucun paiement à cette étape.</p>
        </div>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/demande-de-site-web/">Parler de mon projet</a>
          {site.whatsapp
            ? <a class="btn btn-ghost" href={`https://wa.me/${site.whatsapp}`} rel="noopener" target="_blank" data-event="WhatsApp">Écrire sur WhatsApp</a>
            : <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>}
          {site.phone && <a class="btn btn-ghost" href={`tel:${site.phone}`}>{site.phoneDisplay}</a>}
        </div>
      </div>
    </div>
  </section>
</Base>
