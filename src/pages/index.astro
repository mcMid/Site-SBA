---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Price from '../components/Price.astro';
import ScrollExpandHero from '../components/ui/ScrollExpandHero.astro';
import Founder from '../components/Founder.astro';
import Realisations from '../components/Realisations.astro';
import { site, reviews } from '../config/site';
import { offers, compare, payment, care, guarantee, steps, faq, formatChf, minPrice } from '../config/offre';
import { organization, website, service, faqPage } from '../lib/schema';

const [essentiel, complet] = offers;
const title = `Site à prix fixe pour PME, Suisse romande, dès ${formatChf(minPrice)} CHF`;
const description = `Deux prix fixes, ${formatChf(essentiel.price)} ou ${formatChf(complet.price)} CHF, pour indépendants et PME en Suisse romande. ${payment.deposit} % à la commande, le solde à la mise en ligne. Délai : ${essentiel.delayDays} à ${complet.delayDays} jours ouvrés.`;
---
<Base title={title} description={description} preloadImage="/hero/site.webp?v=ecran" schemas={[organization(), website(), service(), faqPage()]}>

  <!-- Hero : une maquette de site s'ouvre au défilement jusqu'à remplir
       l'écran. -->
  <ScrollExpandHero
    mediaSrc="/hero/site.webp?v=ecran" mediaWidth={1600} mediaHeight={1000}
    bgSrc="/hero/bg.webp?v=photo"
    titleLeft="Votre site," titleRight="à prix fixe."
    pitchKicker="Essentiel"
    pitchTitle="Votre site"
    pitchPrice={`${formatChf(essentiel.price)} CHF`}
    pitchNote={`Prix fixe. En ligne en ${essentiel.delayDays} jours ouvrés.`}
    ctaHref="/demande/?offre=essentiel" ctaLabel="Écrire pour ce prix"
  >
    <p slot="top" class="kicker xh-kicker">Indépendants et PME, Suisse romande</p>
    <div slot="bottom" class="xh-offers">
      {offers.map((o) => (
        <a href={`/demande/?offre=${o.id}`}>{o.name} <strong class="num">{formatChf(o.price)} CHF</strong></a>
      ))}
    </div>
  </ScrollExpandHero>

  <section class="intro" aria-label="En bref">
    <div class="wrap">
      <p class="hero-lede">
        Deux offres, {formatChf(essentiel.price)} ou {formatChf(complet.price)} CHF. Le tableau plus bas dit ce qui est compris, et ce qui ne l’est pas.
      </p>
      <div class="hero-actions">
        <a class="text-link" href="#inclus">Le détail, ligne par ligne</a>
      </div>
      {reviews.count > 0 && (
        <a class="rating" href={reviews.url} rel="noopener" target="_blank">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <strong>{reviews.rating.toFixed(1).replace('.', ',')}/5</strong> sur Google, {reviews.count} avis
        </a>
      )}
      <ul class="proofs">
        <li>Le chiffre sur cette page est le chiffre facturé. Pas de devis, pas de « nous consulter ».</li>
        <li>{guarantee.short}</li>
        <li>Hébergement offert la 1re année. Ensuite {care.price} CHF par mois, seulement si vous le gardez. Délai : {essentiel.delayDays} à {complet.delayDays} jours ouvrés.</li>
      </ul>
    </div>
  </section>

  <!-- Offres -->
  <section class="section" id="offres" aria-labelledby="offres-titre">
    <div class="wrap">
      <div class="section-head">
        <h2 id="offres-titre">Essentiel ou Complet. Le prix est déjà écrit.</h2>
      </div>
      <div class="offers">
        {offers.map((o, i) => (
          <article class:list={['offer', { 'is-featured': i === 1 }]} id={`offre-${o.id}`} aria-labelledby={`t-${o.id}`}>
            <div class="offer-top">
              <h3 class="offer-name" id={`t-${o.id}`}>{o.name}</h3>
            </div>
            <Price value={o.price} />
            <p class="for">{o.forWho}</p>
            <p style="margin:0">{o.pitch}</p>
            <ul>
              {o.highlights.map((h) => <li><Icon name="check" /><span>{h}</span></li>)}
            </ul>
            <dl class="offer-facts">
              <dt>Délai</dt><dd>{o.delayDays} jours ouvrés</dd>
              <dt>Corrections</dt><dd>{o.revisionRounds} {o.revisionRounds > 1 ? 'tours' : 'tour'} + garantie</dd>
              <dt>À la commande</dt><dd class="num">{formatChf(o.price * payment.deposit / 100)} CHF</dd>
              <dt>À la mise en ligne</dt><dd class="num">{formatChf(o.price * (100 - payment.deposit) / 100)} CHF</dd>
            </dl>
            <a class:list={['btn', i === 1 ? 'btn-primary' : 'btn-ghost']} href={`/demande/?offre=${o.id}`}>
              Choisir {o.name}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Tableau oui / non -->
  <section class="section" id="inclus" aria-labelledby="inclus-titre">
    <div class="wrap">
      <div class="section-head">
        <h2 id="inclus-titre">Ce qui est compris, et ce qui ne l’est pas.</h2>
        <p class="lede">Pas d’option qui apparaît sur la facture. Si une ligne dit non, elle n’est pas comprise, et on vous le dit avant de commencer. Pour comparer avec d’autres offres : <a href="/prix-site-internet-suisse/">combien coûte un site en Suisse en 2026</a>.</p>
      </div>
      <div class="compare-wrap">
        <table class="compare">
          <caption>Délai compté en jours ouvrés, à partir de la réception de vos contenus complets.</caption>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Prestation</span></th>
              {offers.map((o) => <th scope="col">{o.name}<span class="p num">{formatChf(o.price)} CHF</span></th>)}
            </tr>
          </thead>
          <tbody>
            {compare.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {[row.essentiel, row.complet].map((c) =>
                  <td>
                    {c === true && <span class="yes"><Icon name="check" />Oui</span>}
                    {c === false && <span class="no"><Icon name="minus" />Non</span>}
                    {typeof c === 'string' && <span class="txt">{c}</span>}
                  </td>
                )}
              </tr>
            ))}
            <tr>
              <th scope="row">Délai de mise en ligne</th>
              {offers.map((o) => <td><span class="txt">{o.delayDays} jours</span></td>)}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Paiement et abonnement -->
  <section class="section" id="paiement" aria-labelledby="paiement-titre">
    <div class="wrap">
      <div class="section-head">
        <h2 id="paiement-titre">Vous payez la moitié. Le reste quand le site est en ligne.</h2>
      </div>
      <div class="split">
        <div class="panel">
          <h3>L’acompte, puis le solde</h3>
          <div class="bar" aria-label={`${payment.deposit} % ${payment.depositWhen}, ${100 - payment.deposit} % ${payment.balanceWhen}`}>
            <div><strong>{payment.deposit} %</strong><span>{payment.depositWhen}</span></div>
            <div><strong>{100 - payment.deposit} %</strong><span>{payment.balanceWhen}</span></div>
          </div>
          <p>Le solde n’est dû que lorsque le site est en ligne, sur votre nom de domaine, après les corrections comprises dans votre offre.</p>
          <p class="guarantee"><Icon name="check" /><span><strong>Garantie.</strong> {guarantee.long}</span></p>
          <p class="muted" style="margin:0">Paiement par {site.paymentMethods.join(', ').replace(/, ([^,]*)$/, ' ou $1')}.</p>
        </div>
        <div class="panel">
          <h3>Après la mise en ligne</h3>
          <p>{care.freeFirstYear}</p>
          <div class="care-price">
            <Price value={care.price} suffix=" / mois" />
            <span class="optional">Facultatif</span>
          </div>
          <ul>{care.includes.map((i) => <li>{i}</li>)}</ul>
          <p class="muted" style="margin:0">{care.cancel} {care.without}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Étapes -->
  <section class="section" id="etapes" aria-labelledby="etapes-titre">
    <div class="wrap">
      <div class="section-head">
        <h2 id="etapes-titre">De la demande à la mise en ligne.</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step">
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <div>
              <h3><span class="sr-only">Étape {i + 1} : </span>{s.title}</h3>
              <p>{s.text}</p>
              <div class="step-meta">
                <span class="chip">{s.who === 'vous' ? 'De votre côté' : 'De notre côté'}</span>
                {s.money && <span class="chip money">{s.money}</span>}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Realisations />
  <Founder />

  <!-- Corrections -->
  <section class="section" id="corrections" aria-labelledby="corrections-titre">
    <div class="wrap">
      <div class="rule-box">
        <span class="big" aria-hidden="true">3</span>
        <div>
          <h2 id="corrections-titre">Trois tours sur l’offre Complet. Un sur l’Essentiel.</h2>
          <p class="lede" style="margin-top:1rem">Chaque tour, vous regroupez vos remarques et on les applique en une fois. Un cadre clair, pas un chantier sans fin. Et si la maquette ne vous convient toujours pas : on arrête, acompte remboursé.</p>
          <div class="rule-lists">
            <div>
              <h3>Compris dans ces tours</h3>
              <ul>
                <li>Modifier ou remplacer des textes</li>
                <li>Changer des photos</li>
                <li>Ajuster couleurs et ordre des sections</li>
              </ul>
            </div>
            <div>
              <h3>Pas compris</h3>
              <ul>
                <li>Repartir sur un autre design</li>
                <li>Ajouter des pages hors offre</li>
                <li>Un tour en plus, sauf accord sur le prix avant</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="questions" aria-labelledby="faq-titre">
    <div class="wrap">
      <div class="section-head">
        <h2 id="faq-titre">Avant de commencer</h2>
      </div>
      <div class="faq">
        {faq.map(({ q, a }) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Appel final -->
  <section class="section final" aria-labelledby="final-titre">
    <div class="wrap">
      <h2 class="final-head" id="final-titre">
        <span class="final-l1">Une demande prend </span>
        <span class="final-l2">une minute. </span>
        <span class="final-k">On répond sous </span>
        <span class="final-n">{site.responseTime}</span>
      </h2>
      <div class="final-bar">
        <div class="final-terms">
          <p>Aucun engagement tant que vous n’avez pas validé l’offre par écrit.</p>
          <p>{guarantee.short}</p>
        </div>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/demande/">Envoyer une demande</a>
          {site.whatsapp
            ? <a class="btn btn-ghost" href={`https://wa.me/${site.whatsapp}`} rel="noopener" target="_blank" data-event="WhatsApp">Écrire sur WhatsApp</a>
            : <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>}
          {site.phone && <a class="btn btn-ghost" href={`tel:${site.phone}`}>{site.phoneDisplay}</a>}
        </div>
      </div>
    </div>
  </section>
</Base>
