---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { offers, payment, guarantee, formatChf } from '../config/offre';
import { breadcrumb } from '../lib/schema';

const title = 'Parler de votre projet de site internet';
const description = `Quelques informations suffisent pour comprendre votre activité. Réponse sous ${site.responseTime}, avec la formule adaptée. Aucun paiement à cette étape.`;
---
<Base title={title} description={description} headerCta={false}
  schemas={[breadcrumb([{ name: 'Accueil', path: '/' }, { name: 'Demande de site web', path: '/demande-de-site-web/' }])]}>
  <section class="page">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a> › Demande de site web</nav>
      <div class="section-head">
        <h1>Parlez-nous de votre projet</h1>
        <p class="lede">Quelques informations suffisent pour comprendre votre activité et vous orienter vers la bonne formule. Réponse sous {site.responseTime}. Rien n’est dû avant votre accord écrit.</p>
        <p class="aside-note">{guarantee.short}</p>
      </div>

      <form class="form" name="demande" method="POST" action="/merci/" data-netlify="true" netlify-honeypot="societe_web">
        <input type="hidden" name="form-name" value="demande" />
        <p class="hp" aria-hidden="true"><label>Ne pas remplir <input name="societe_web" tabindex="-1" autocomplete="off" /></label></p>

        <fieldset class="field">
          <legend>Quelle formule vous correspond ?</legend>
          <div class="choices">
            {offers.map((o) => (
              <div class="choice">
                <input type="radio" name="offre" id={`offre-${o.id}`} value={o.id} />
                <label for={`offre-${o.id}`}>{o.name}<small class="num">{formatChf(o.price)} CHF, {o.delayDays} jours ouvrés</small></label>
              </div>
            ))}
            <div class="choice">
              <input type="radio" name="offre" id="offre-hesite" value="hesite" checked />
              <label for="offre-hesite">Je ne sais pas encore<small>Nous vous orientons vers la formule adaptée</small></label>
            </div>
          </div>
        </fieldset>

        <div class="two">
          <div class="field">
            <label for="nom">Prénom et nom</label>
            <input id="nom" name="nom" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="email">E-mail</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>

        <div class="field">
          <label for="tel">Téléphone <span class="hint">(facultatif, si vous préférez un appel ou WhatsApp)</span></label>
          <input id="tel" name="telephone" type="tel" autocomplete="tel" inputmode="tel" />
        </div>

        <div class="field">
          <label for="message">Votre activité, et ce que le site doit permettre <span class="hint">(facultatif)</span></label>
          <textarea id="message" name="message" placeholder="ex. Menuiserie à Morges. Je veux que l’on comprenne mon métier, et que l’on puisse me contacter."></textarea>
        </div>

        <div class="consent">
          <input type="checkbox" id="consentement" name="consentement" value="oui" required />
          <label for="consentement">J’accepte que mes données servent uniquement à répondre à cette demande. Elles ne sont ni vendues ni transmises. <a href="/confidentialite/">Confidentialité</a></label>
        </div>

        <div>
          <button class="btn btn-primary" type="submit">Envoyer ma demande</button>
        </div>
        <p class="aside-note">Aucun paiement à cette étape. {payment.deposit} % {payment.depositWhen}, {100 - payment.deposit} % {payment.balanceWhen}, seulement après votre accord écrit.</p>
      </form>
    </div>
  </section>
  <script is:inline defer src="/scripts/demande.js"></script>
</Base>
